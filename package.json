  "scripts": {
    "check:audio-assets": "node scripts/verify-home-drive-audio-assets.mjs",
    "preinstall": "node -e \"if(process.version !== 'v26.10.0'){console.error('Node 26.10.0 obrigatorio. Versao atual: ' + process.version); process.exit(1)}\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ci": "tsc && vite build && node scripts/prepare-github-pages.mjs",
    "serve": "vite preview",
    "update": "npm update && npm outdated",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "tsc && eslint \"src/**/*.{js,ts,tsx}\" --quiet --fix",
    "pre-commit": "npx lint-staged -d",
    "pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
    "depcheck": "depcheck",
    "storybook-generate": "sb-rn-get-stories",
    "storybook-watch": "sb-rn-watcher",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:landing": "playwright test e2e/cognitive-network.spec.ts e2e/floating-chat.spec.ts e2e/github-pages-fallback.spec.ts e2e/landing-navigation.spec.ts e2e/landing-viewport-roundtrip.spec.ts",
    "test:e2e:viewport": "playwright test e2e/landing-viewport-roundtrip.spec.ts",
    "test:relay": "node --test services/telegram-relay/test/*.test.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "8.0.1",
    "@babel/plugin-transform-optional-chaining": "8.0.5",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@eslint-react/eslint-plugin": "5.23.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "10.6.1",
    "gh-pages": "6.3.0",
    "globals": "17.12.0",
    "msw": "3.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "serve": "14.2.6",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "web-vitals": "6.2.2",
    "webpack": "5.111.1",
    "@babel/preset-env": "8.0.6",
    "@babel/core": "8.0.6"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "npm run lint",
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": "=26.10.0"
  },
  "volta": {
    "node": "26.10.0",
    "npm": "12.1.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
