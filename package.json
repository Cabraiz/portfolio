		"eslint-plugin-react": "7.37.5",
		"gh-pages": "6.3.0",
		"globals": "17.4.0",
		"msw": "2.12.14",
		"prettier": "3.8.1",
		"prettier-plugin-organize-imports": "4.3.0",
		"storybook": "10.3.3",
		"typescript": "6.0.2",
		"typescript-eslint": "8.58.0",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.2",
		"web-vitals": "5.2.0",
		"webpack": "5.105.4"
	},
	"lint-staged": {
		"**/*.{js,jsx}": [
			"npm run lint",
			"prettier --write"
		]
	},
	"resolutions": {
		"nth-check": ">=2.0.1",
		"protobufjs": ">=7.2.4"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"engines": {
		"node": "=25.8.1"
	},
	"volta": {
		"node": "25.8.1"
	}
}
