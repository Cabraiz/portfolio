	"scripts": {
		"preinstall": "node -e \"if(process.version !== 'v25.8.1'){console.error('Node 25.8.1 obrigatorio. Versao atual: ' + process.version); process.exit(1)}\"",
		"dev": "vite",
		"build": "tsc && vite build",
		"build:ci": "tsc && vite build && cp 404.html dist/",
		"serve": "vite preview",
		"update": "npm update && npm outdated",
		"deploy": "npm run build && gh-pages -d dist",
		"lint": "tsc && eslint \"src/**/*.{js,ts,tsx}\" --quiet --fix",
		"pre-commit": "npx lint-staged -d",
		"pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
		"depcheck": "depcheck",
		"storybook-generate": "sb-rn-get-stories",
		"storybook-watch": "sb-rn-watcher",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest",
			"plugin:storybook/recommended"
		]
	},
	"devDependencies": {
		"@babel/plugin-transform-class-properties": "7.27.1",
		"@babel/plugin-transform-nullish-coalescing-operator": "7.27.1",
		"@babel/plugin-transform-optional-chaining": "7.27.1",
