{
  "manifest_version": 3,
  "name": "CamCrop No Admin",
  "version": "0.8.0",
  "description": "Transforma a webcam no navegador: seleção, crop, movimento, rotação, espelhamento e nitidez alta, sem driver, sem OBS e sem administrador.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.teams.cloud.microsoft/*",
    "https://app.zoom.us/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "CamCrop",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "pageHook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "contentBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}